{
  "name": "@pushkaralu/api",
  "version": "0.1.0",
  "private": true,
  "description": "Pushkaralu Reunite API (NestJS + Kysely + PostGIS).",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:up": "tsx src/database/migrator.ts up",
    "migrate:down": "tsx src/database/migrator.ts down",
    "migrate:latest": "tsx src/database/migrator.ts latest",
    "seed": "tsx src/database/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@pushkaralu/shared": "workspace:*",
    "argon2": "^0.45.2",
    "dotenv": "^18.0.9",
    "kysely": "^0.27.5",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
