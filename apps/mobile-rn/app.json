{
  "expo": {
    "name": "Pushkaralu Reunite",
    "slug": "pushkaralu-reunite",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "pushkaralu",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF6ED"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.gov.ap.pushkaralu.reunite",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan wristband QR and capture live photos for reunification.",
        "NSLocationWhenInUseUsageDescription": "Share last-seen location when reporting a missing person."
      }
    },
    "android": {
      "package": "in.gov.ap.pushkaralu.reunite",
      "adaptiveIcon": {
        "backgroundColor": "#FBF6ED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-location",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Pushkaralu Reunite to scan wristband QR codes and take live photos."
        }
      ]
    ]
  }
}
