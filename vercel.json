{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install -g pnpm@9.15.0 && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @pushkaralu/shared build && pnpm --filter @pushkaralu/mobile run build:web",
  "outputDirectory": "apps/mobile-rn/dist-web",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}